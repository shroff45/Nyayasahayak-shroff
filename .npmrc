# Why this file exists
#
# @react-three/drei@10 (and @react-three/fiber@9) declare peerDependencies on react@^19, while
# this app pins react@18.3.1. The project has always been installed with the peer check relaxed -
# that is invisible in a repo that commits node_modules, and it is why `npm ci` on a clean clone
# stopped at ERESOLVE instead of reaching the typecheck.
#
# Recording it here means CI, a fresh clone and a new hire all resolve the same tree. It is a
# workaround, not a solution: the fix is either moving the app to React 19 or dropping drei/fiber
# to the v9/v8 pair that supports React 18. Both are dependency upgrades that change the 3D orb's
# component API, so they belong in their own verified block rather than smuggled into a build fix.
legacy-peer-deps=true
